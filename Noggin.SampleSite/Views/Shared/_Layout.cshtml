<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Noggin Auth</title>

    <environment names="Development">
        <link rel="stylesheet" href="~/lib/bulma/css/bulma.css" />
        <link rel="stylesheet" href="~/css/site.css" />
    </environment>
    <environment names="Staging,Production">
        <link rel="stylesheet" href="~/lib/bulma/css/bulma.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <header class="container">
        <nav class="level p-4">
            <div class="level-left">
                <a class="level-item title is-4" asp-controller="Home" asp-action="Index">Noggin Auth Demo</a>
            </div>
            <div class="level-right">
                <a class="level-item" asp-controller="Home" asp-action="Index">Home</a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <span class="level-item">Log in with:</span>
                    <div class="level-item buttons">
                        <auth-link provider="github" class="button is-small">GitHub</auth-link>
                        <auth-link provider="google" class="button is-small">Google</auth-link>
                        <auth-link provider="facebook" class="button is-small">Facebook</auth-link>
                        <auth-link provider="microsoft" class="button is-small">Microsoft</auth-link>
                    </div>
                }
                else
                {
                    <a class="level-item" asp-controller="UserAdmin" asp-action="Index">User admin</a>
                    <a class="level-item button is-small" asp-controller="Home" asp-action="Logout">Log out</a>
                }
            </div>
        </nav>
    </header>

    @RenderSection("Hero", required: false)

    <main class="section">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <p class="has-text-centered">&copy; @DateTime.Now.Year - <a href="http://www.nogginbox.co.uk">Richard Garside (Nogginbox)</a></p>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
